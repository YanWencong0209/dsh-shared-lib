{
  "name": "dsh-shared-lib",
  "description": "共享库：跨工作区/跨会话共用的工具 bin、开发环境、技能目录；融合 meow-memory 七层记忆与 mnemon 记忆空间（可选）",
  "version": "0.6.1",
  "type": "module",
  "main": "lib/bundle.js",
  "cordis": {
    "entry": "lib/bundle.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/bundle.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "test",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json",
    "icon.svg",
    "TARGETS.md",
    "CASE-MEMORY.md",
    "CHANGELOG.md"
  ]
}
